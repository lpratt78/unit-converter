<Window x:Class="UnitConverter.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unit Converter"
        Width="360" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- Unit rows: name on the left, symbol on the right -->
        <DataTemplate x:Key="UnitTemplate">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Right" Text="{Binding Symbol}" Margin="8,0,0,0"
                           Foreground="{StaticResource SubtleBrush}" />
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </DataTemplate>

        <DataTemplate x:Key="MaterialTemplate">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" Foreground="{StaticResource SubtleBrush}"
                           Text="{Binding KgPerL, StringFormat={}{0:0.###} kg/L}" />
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </DataTemplate>

        <DataTemplate x:Key="PresetTemplate">
            <TextBlock Text="{Binding Name}" />
        </DataTemplate>
    </Window.Resources>

    <!-- Margin leaves room for the drop shadow -->
    <Border Margin="12" CornerRadius="10" Background="{StaticResource WindowBrush}"
            BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1" Padding="12,8,12,12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.45" Color="Black" />
        </Border.Effect>

        <StackPanel>
            <!-- Title bar: mode, pin, hide -->
            <DockPanel Margin="0,0,0,10">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton x:Name="PinButton" Style="{StaticResource IconToggle}" Content="&#xE718;"
                                  ToolTip="Keep on top" Click="PinButton_Click" />
                    <Button Style="{StaticResource IconPush}" Content="&#xE921;" ToolTip="Hide to tray (Esc)"
                            Click="HideButton_Click" />
                </StackPanel>
                <ComboBox x:Name="ModeBox" Style="{StaticResource DarkComboBox}" Width="170"
                          HorizontalAlignment="Left" FontWeight="SemiBold" MaxDropDownHeight="420"
                          SelectionChanged="ModeBox_SelectionChanged"
                          ToolTip="Category (Ctrl+1 … Ctrl+9)" />
            </DockPanel>

            <!-- ============ Unit conversion (also mass ↔ volume) ============ -->
            <StackPanel x:Name="UnitPanel">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FromBox" Style="{StaticResource ValueBox}" TextChanged="ValueBox_TextChanged"
                             GotKeyboardFocus="TextBox_GotKeyboardFocus" />
                    <ComboBox x:Name="FromUnitBox" Grid.Column="2" Style="{StaticResource DarkComboBox}" Height="40"
                              ItemTemplate="{StaticResource UnitTemplate}" SelectionChanged="UnitBox_SelectionChanged" />
                </Grid>

                <Button Style="{StaticResource IconPush}" Content="&#xE8CB;" HorizontalAlignment="Center"
                        Margin="0,4" ToolTip="Swap (Ctrl+R)" Click="SwapButton_Click" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ToBox" Style="{StaticResource ValueBox}" TextChanged="ValueBox_TextChanged"
                             GotKeyboardFocus="TextBox_GotKeyboardFocus" />
                    <ComboBox x:Name="ToUnitBox" Grid.Column="2" Style="{StaticResource DarkComboBox}" Height="40"
                              ItemTemplate="{StaticResource UnitTemplate}" SelectionChanged="UnitBox_SelectionChanged" />
                </Grid>

                <!-- Density, for mass ↔ volume only -->
                <StackPanel x:Name="DensityPanel" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Density" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="DensityBox" Grid.Column="1" Style="{StaticResource SmallBox}"
                                 TextChanged="DensityBox_TextChanged" GotKeyboardFocus="TextBox_GotKeyboardFocus" />
                        <ComboBox x:Name="DensityUnitBox" Grid.Column="3" Style="{StaticResource DarkComboBox}"
                                  DisplayMemberPath="Symbol" SelectionChanged="DensityUnitBox_SelectionChanged" />
                    </Grid>
                    <ComboBox x:Name="MaterialBox" Margin="72,6,0,0" Style="{StaticResource DarkComboBox}"
                              Tag="Material preset…" ItemTemplate="{StaticResource MaterialTemplate}"
                              SelectionChanged="MaterialBox_SelectionChanged" />
                </StackPanel>

                <!-- Multiplier, applied to every result -->
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Multiplier" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="MultiplierBox" Grid.Column="1" Style="{StaticResource SmallBox}"
                             TextChanged="MultiplierBox_TextChanged" GotKeyboardFocus="TextBox_GotKeyboardFocus"
                             ToolTip="The result is multiplied by this. 1 = off." />
                    <TextBlock Grid.Column="2" Margin="8,0,0,0" Style="{StaticResource FieldLabel}"
                               Text="× result" />
                </Grid>
            </StackPanel>

            <!-- ============ Linear scaling ============ -->
            <StackPanel x:Name="ScalePanel">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Column="1" Text="Min" Style="{StaticResource FieldLabel}" Margin="2,0,0,4" />
                    <TextBlock Grid.Column="3" Text="Max" Style="{StaticResource FieldLabel}" Margin="2,0,0,4" />

                    <TextBlock Grid.Row="1" Text="Input" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="InMinBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource SmallBox}"
                             TextChanged="RangeBox_TextChanged" GotKeyboardFocus="TextBox_GotKeyboardFocus" />
                    <TextBox x:Name="InMaxBox" Grid.Row="1" Grid.Column="3" Style="{StaticResource SmallBox}"
                             TextChanged="RangeBox_TextChanged" GotKeyboardFocus="TextBox_GotKeyboardFocus" />

                    <TextBlock Grid.Row="3" Text="Output" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="OutMinBox" Grid.Row="3" Grid.Column="1" Style="{StaticResource SmallBox}"
                             TextChanged="RangeBox_TextChanged" GotKeyboardFocus="TextBox_GotKeyboardFocus" />
                    <TextBox x:Name="OutMaxBox" Grid.Row="3" Grid.Column="3" Style="{StaticResource SmallBox}"
                             TextChanged="RangeBox_TextChanged" GotKeyboardFocus="TextBox_GotKeyboardFocus" />
                </Grid>

                <ComboBox x:Name="ScalePresetBox" Margin="56,6,0,0" Style="{StaticResource DarkComboBox}"
                          Tag="Input range preset…" ItemTemplate="{StaticResource PresetTemplate}"
                          SelectionChanged="ScalePresetBox_SelectionChanged" />

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Input" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="ScaleInBox" Grid.Column="1" Style="{StaticResource ValueBox}"
                             TextChanged="ValueBox_TextChanged" GotKeyboardFocus="TextBox_GotKeyboardFocus" />
                </Grid>

                <Button Style="{StaticResource IconPush}" Content="&#xE8CB;" HorizontalAlignment="Center"
                        Margin="56,4,0,4" ToolTip="Swap input and output ranges (Ctrl+R)" Click="SwapButton_Click" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Output" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="ScaleOutBox" Grid.Column="1" Style="{StaticResource ValueBox}"
                             TextChanged="ValueBox_TextChanged" GotKeyboardFocus="TextBox_GotKeyboardFocus" />
                </Grid>
            </StackPanel>

            <!-- Footer: rate or formula, and copy -->
            <DockPanel Margin="0,10,0,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource IconPush}" Content="&#xE8C8;"
                        ToolTip="Copy result (Ctrl+Shift+C)" Click="CopyButton_Click" />
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12"
                           Foreground="{StaticResource SubtleBrush}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
